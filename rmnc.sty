\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rmnc}[2026/04/22 v2.0 Pacote L3]
\RequirePackage{xfp}
\RequirePackage{pgfplots}
\RequirePackage{tikz}

% Ativa a sintaxe de programação do LaTeX3
\ExplSyntaxOn

% Lembre-se de definir a variável antes (caso não tenha feito)
\int_new:N \l_rmnc_intensidade_int
\int_new:N \l_rmnc_ppmini_int
\int_new:N \l_rmnc_ppmfin_int
\int_new:N \l_rmnc_escala_int
\str_new:N \l_rmnc_dominio_str
\dim_new:N \l_rmnc_largura_dim
\dim_new:N \l_rmnc_altura_dim

\keys_define:nn { rmnc }
{
	int .int_set:N = \l_rmnc_intensidade_int,
	int .initial:n = { 100 },
}

\NewDocumentCommand{\sinal}{ O{} m }
{
	\group_begin:
	\keys_set:nn { rmnc } { #1 }
	
	
	
	% Importante: Para o pgfplots, usamos 'row sep=\\' e o '~' como espaço
	\addplot [smooth, line~width=0.8] table [row~sep=\\, col~sep=space] {
		A ~ B \\
		\fpeval{#2 - 0.04} ~ \fpeval{\l_rmnc_intensidade_int * 0.0} \\
		\fpeval{#2 - 0.03} ~ \fpeval{\l_rmnc_intensidade_int * 0.05} \\
		\fpeval{#2 - 0.02} ~ \fpeval{\l_rmnc_intensidade_int * 0.2} \\
		\fpeval{#2 - 0.01} ~ \fpeval{\l_rmnc_intensidade_int * 0.5} \\
		\fpeval{#2}        ~ \fpeval{\l_rmnc_intensidade_int * 1.0} \\
		\fpeval{#2 + 0.01} ~ \fpeval{\l_rmnc_intensidade_int * 0.5} \\
		\fpeval{#2 + 0.02} ~ \fpeval{\l_rmnc_intensidade_int * 0.2} \\
		\fpeval{#2 + 0.03} ~ \fpeval{\l_rmnc_intensidade_int * 0.05} \\
		\fpeval{#2 + 0.04} ~ \fpeval{\l_rmnc_intensidade_int * 0.0} \\
	};
	\group_end:
}

\keys_define:nn { rmnc }
{
	ppmini .int_set:N  = \l_rmnc_ppmini_int,
	ppmini .initial:n = { 0 },
	ppmfin   .int_set:N  = \l_rmnc_ppmfin_int,
	ppmfin   .initial:n = { 200 },
	escala .int_set:N = \l_rmnc_escala_int,
	escala .initial:n = { 50 },
	dominio.str_set:N = \l_rmnc_dominio_str,
	dominio.initial:n = { 0:200 },
	largura.dim_set:N = \l_rmnc_largura_dim,
	largura.initial:n = { 16cm },
	altura .dim_set:N = \l_rmnc_altura_dim,
	altura .initial:n = { 5cm },
}

\NewDocumentEnvironment { espectroc } { O{} }
{
	% --- CÓDIGO DE ABERTURA (\begin) ---
	\group_begin:
	\keys_set:nn { rmnc } { #1 }
	
	\begin{tikzpicture}
		\begin{axis}[xmin=\int_use:N \l_rmnc_ppmini_int,
			xmax= \int_use:N \l_rmnc_ppmfin_int,
			ymin=-5,
			ymax=110,
			ytick=\empty,
			x~dir=reverse,
			xtick~distance = \int_use:N \l_rmnc_escala_int,
			width=\dim_use:N \l_rmnc_largura_dim,
			height=\dim_use:N \l_rmnc_altura_dim,
			xlabel={ppm}]
			
			\addplot[domain= \l_rmnc_dominio_str , line~width=0.5]{0};
		}
		{
			% --- CÓDIGO DE FECHAMENTO (\end) ---
		\end{axis}
	\end{tikzpicture}
	\group_end:
}

\ExplSyntaxOff